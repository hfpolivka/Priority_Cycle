{
    "manifest_version": 3,
    "name": "Priority Cycle",
    "version": "1.0",
    "description": "Iterates through current skills/projects",
    "icons": {
        "128": "images/sandglass128.png",
        "48": "images/sandglass48.png",
        "16": "images/sandglass24.png"
    },
    "action": {
        "default_popup": "priority.html",
        "default_icon": {
          "16": "images/sandglass24.png",
          "48": "images/sandglass48.png",
          "128": "images/sandglass128.png"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self';"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "alarms",
        "notifications",
        "pushMessaging"
    ],
    "background": {
        "service_worker": "background.js"
    }
}